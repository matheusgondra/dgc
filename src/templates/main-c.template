#include "String.h"
#include <stdio.h>
#include <stdlib.h>

int main() {
  printf("Created with String API\n");

  string_t message = string_from("Hello World");
  size_t message_length = string_length(&message);

  string_println(&message);
  printf("Message length: %zu\n", message_length);

  string_free(&message);

  return EXIT_SUCCESS;
}
